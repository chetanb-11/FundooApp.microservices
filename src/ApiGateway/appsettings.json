{
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "user-cluster",
        "Match": {
          "Path": "/api/fundoo/auth/{**catch-all}"
        }
      },
      "notes-route": {
        "ClusterId": "note-cluster",
        "Match": {
          "Path": "/api/fundoo/notes/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "user-cluster": {
        "Destinations": {
          "user-service": {
            "Address": "http://localhost:5101/"
          }
        }
      },
      "note-cluster": {
        "Destinations": {
          "note-service": {
            "Address": "http://localhost:5102/"
          }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*"
}
